PORT=3001
DATABASE_URL="postgresql://chainos_app:password@localhost:5432/chainos?schema=public"

# JWT signing secrets — must differ from each other, and be a random
# string of at least 32 bytes in every real environment. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-me-32-bytes-minimum"
JWT_REFRESH_SECRET="replace-me-different-32-bytes-minimum"
