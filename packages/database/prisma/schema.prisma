// ChainOS data model — phase 0 scaffold.
//
// Multi-tenancy: every tenant-scoped table carries `tenantId` and has a
// matching Postgres row-level security policy (see prisma/rls.sql). The
// app layer sets `app.tenant_id` per request/connection; RLS enforces the
// filter even if a query forgets a `WHERE tenantId = ...` clause.
//
// Inventory: `StockLevel` is a materialized cache (quantityOnHand /
// quantityReserved), always written in the same transaction as the
// `StockMovement` row that caused the change. `StockMovement` is the
// source of truth and is never updated or deleted, only inserted.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core kernel: tenancy + IAM
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users            User[]
  suppliers        Supplier[]
  products         Product[]
  warehouses       Warehouse[]
  customers        Customer[]
  purchaseOrders   PurchaseOrder[]
  customerOrders   CustomerOrder[]
  shipments        Shipment[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  name      String
  roleId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// MVP RBAC: a role is a named bundle of capability strings, e.g.
// "po:create", "po:receive", "inventory:adjust". Scoped per tenant so
// each org can tailor roles without a global permissions table.
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Catalog (products live here; Supplier itself is owned by Procurement,
// below — SupplierProduct is Catalog's join table onto it)
// ---------------------------------------------------------------------------

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  sku       String
  name      String
  uom       String   @default("EACH")
  createdAt DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplierProducts    SupplierProduct[]
  purchaseOrderLines  PurchaseOrderLine[]
  customerOrderLines  CustomerOrderLine[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

// Owned by Procurement (see manifest §2 module table).
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

// Supplier-specific view of a product: their SKU, cost, and lead time.
model SupplierProduct {
  id             String  @id @default(uuid())
  tenantId       String
  supplierId     String
  productId      String
  supplierSku    String?
  unitCost       Decimal @db.Decimal(12, 2)
  leadTimeDays   Int?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([tenantId])
  @@map("supplier_products")
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  supplierId   String
  warehouseId  String
  status       PurchaseOrderStatus @default(DRAFT)
  issuedAt     DateTime?
  expectedAt   DateTime?
  createdAt    DateTime            @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]
  shipment  Shipment?

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int     @default(0)
  unitCost        Decimal @db.Decimal(12, 2)

  purchaseOrder  PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  locations        Location[]
  purchaseOrders   PurchaseOrder[]
  customerOrders   CustomerOrder[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  outboundShipments Shipment[]     @relation("OutboundWarehouse")
  inboundShipments  Shipment[]     @relation("InboundWarehouse")

  @@index([tenantId])
  @@map("warehouses")
}

// Bin/location granularity — modeled now, populated starting phase 1.5.
// StockLevel.locationId stays null until then; MVP tracks stock at the
// warehouse level only (see manifest §3).
model Location {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  code        String

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  stockLevels StockLevel[]

  @@unique([warehouseId, code])
  @@index([tenantId])
  @@map("locations")
}

// Materialized cache of on-hand / reserved quantity per product+warehouse
// (+ optional location, phase 1.5+). Always written alongside the
// StockMovement row that caused the change — never written to on its own.
model StockLevel {
  id                String  @id @default(uuid())
  tenantId          String
  productId         String
  warehouseId       String
  locationId        String?
  quantityOnHand    Int     @default(0)
  quantityReserved  Int     @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@unique([productId, warehouseId, locationId])
  @@index([tenantId])
  @@map("stock_levels")
}

enum StockMovementType {
  RECEIPT
  FULFILLMENT
  ADJUSTMENT
  TRANSFER
}

// Append-only ledger. Source of truth for all inventory quantities.
model StockMovement {
  id                  String            @id @default(uuid())
  tenantId            String
  productId           String
  warehouseId         String
  type                StockMovementType
  quantityDelta       Int
  purchaseOrderLineId String?
  customerOrderLineId String?
  note                String?
  createdByUserId     String?
  createdAt           DateTime          @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  customerOrderLine CustomerOrderLine? @relation(fields: [customerOrderLineId], references: [id])

  @@index([tenantId])
  @@index([productId, warehouseId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  customerOrders CustomerOrder[]

  @@index([tenantId])
  @@map("customers")
}

enum CustomerOrderStatus {
  DRAFT
  RESERVED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

model CustomerOrder {
  id          String              @id @default(uuid())
  tenantId    String
  customerId  String
  warehouseId String
  status      CustomerOrderStatus @default(DRAFT)
  createdAt   DateTime            @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  customer  Customer            @relation(fields: [customerId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     CustomerOrderLine[]
  shipment  Shipment?

  @@index([tenantId])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id              String @id @default(uuid())
  tenantId        String
  customerOrderId String
  productId       String
  qtyOrdered      Int
  qtyFulfilled    Int    @default(0)

  customerOrder  CustomerOrder   @relation(fields: [customerOrderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("customer_order_lines")
}

// ---------------------------------------------------------------------------
// Logistics
// ---------------------------------------------------------------------------

enum ShipmentDirection {
  INBOUND
  OUTBOUND
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

// One entity for both legs (see manifest §1): inbound ties to a
// PurchaseOrder + origin supplier, outbound ties to a CustomerOrder +
// destination customer. v1 tracking is manual (status set by hand);
// `carrier` / `trackingNumber` are captured for reference only until a
// carrier integration lands.
model Shipment {
  id                String            @id @default(uuid())
  tenantId          String
  direction         ShipmentDirection
  status            ShipmentStatus    @default(PENDING)
  purchaseOrderId   String?           @unique
  customerOrderId   String?           @unique
  originWarehouseId String?
  destWarehouseId   String?
  carrier           String?
  trackingNumber    String?
  createdAt         DateTime          @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  customerOrder CustomerOrder? @relation(fields: [customerOrderId], references: [id])
  originWarehouse Warehouse?   @relation("InboundWarehouse", fields: [originWarehouseId], references: [id])
  destWarehouse   Warehouse?   @relation("OutboundWarehouse", fields: [destWarehouseId], references: [id])
  events        ShipmentEvent[]

  @@index([tenantId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  tenantId   String
  shipmentId String
  status     ShipmentStatus
  note       String?
  occurredAt DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId])
  @@index([shipmentId])
  @@map("shipment_events")
}
