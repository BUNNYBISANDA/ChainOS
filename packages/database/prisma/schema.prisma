// ChainOS data model — phase 0 scaffold.
//
// Multi-tenancy: every tenant-scoped table carries `tenantId` and has a
// matching Postgres row-level security policy (see prisma/rls.sql). The
// app layer sets `app.tenant_id` per request/connection; RLS enforces the
// filter even if a query forgets a `WHERE tenantId = ...` clause.
//
// Inventory: `StockLevel` is a materialized cache (quantityOnHand /
// quantityReserved), always written in the same transaction as the
// `StockMovement` row that caused the change. `StockMovement` is the
// source of truth and is never updated or deleted, only inserted.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core kernel: tenancy + IAM
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users            User[]
  suppliers        Supplier[]
  products         Product[]
  warehouses       Warehouse[]
  customers        Customer[]
  purchaseOrders   PurchaseOrder[]
  customerOrders   CustomerOrder[]
  shipments        Shipment[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  roleId       String
  createdAt    DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// One row per issued refresh token, so a token can be revoked/rotated
// server-side instead of only relying on JWT expiry. Only the hash is
// stored — the raw token is never persisted (see apps/api AuthService).
model RefreshToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

// MVP RBAC: a role is a named bundle of capability strings, e.g.
// "po:create", "po:receive", "inventory:adjust". Scoped per tenant so
// each org can tailor roles without a global permissions table.
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Catalog (products live here; Supplier itself is owned by Procurement,
// below — SupplierProduct is Catalog's join table onto it)
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  sku         String
  name        String
  description String?
  category    String?
  uom         String   @default("EACH")
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplierProducts    SupplierProduct[]
  purchaseOrderLines  PurchaseOrderLine[]
  customerOrderLines  CustomerOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// Owned by Procurement (see manifest §2 module table).
model Supplier {
  id          String         @id @default(uuid())
  tenantId    String
  code        String
  name        String
  country     String?
  contactName String?
  email       String?
  phone       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("suppliers")
}

// Supplier-specific view of a product: their SKU, cost, and lead time.
model SupplierProduct {
  id             String  @id @default(uuid())
  tenantId       String
  supplierId     String
  productId      String
  supplierSku    String?
  unitCost       Decimal @db.Decimal(12, 2)
  leadTimeDays   Int?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([tenantId])
  @@map("supplier_products")
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

// Explicit lifecycle (manifest §2, phase 1 inbound slice). Valid
// transitions are enforced in PurchaseOrdersService, not by the enum
// itself — see docs/adr/0004-purchase-order-lifecycle.md.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  poNumber             String
  supplierId           String
  warehouseId          String
  status               PurchaseOrderStatus @default(DRAFT)
  currency             String              @default("THB")
  notes                String?
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  shipment      Shipment?

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int     @default(0)
  unitCost        Decimal @db.Decimal(12, 2)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  stockMovements    StockMovement[]
  goodsReceiptLines GoodsReceiptLine[]

  @@index([tenantId])
  @@map("purchase_order_lines")
}

// One row per receiving action against a PO (a PO can be received in
// multiple partial receipts). Header + lines exist purely for audit
// traceability ("which receipt caused this ledger movement") — Inventory
// still owns the actual stock mutation, triggered by the po.received
// event this receiving action emits (see InventoryService).
model GoodsReceipt {
  id               String   @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  warehouseId      String
  receivedByUserId String?
  receivedAt       DateTime @default(now())

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  lines         GoodsReceiptLine[]

  @@index([tenantId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String @id @default(uuid())
  tenantId            String
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  qtyReceived         Int

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  stockMovements    StockMovement[]

  @@index([tenantId])
  @@map("goods_receipt_lines")
}

// Tenant-scoped, gap-tolerant sequential numbers (PO-2026-000001,
// SHP-2026-000001, ...). `key` is caller-chosen (e.g. "PO-2026") so the
// sequence resets per prefix+year without a schema change. The increment
// itself is a single atomic UPSERT — see numbering.ts.
model NumberSequence {
  id       String @id @default(uuid())
  tenantId String
  key      String
  value    Int    @default(0)

  @@unique([tenantId, key])
  @@map("number_sequences")
}

// Generic audit trail for sensitive actions (PO approval, etc.) that need
// a durable "who did what, when" record beyond a single approvedBy/At
// column. Append-only, like the inventory ledger.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// Idempotency ledger for domain-event handlers (see manifest §2, phase 0.5
// hardening). A handler that mutates state on a cross-module event must
// insert its (tenantId, eventId) row in the SAME transaction as the state
// mutation before doing any work; a unique-constraint violation on insert
// means the event was already processed, and the handler no-ops. This is
// what makes at-least-once in-process delivery (EventEmitter2 has no
// dedup or persistence of its own) safe to process twice.
model ProcessedEvent {
  id        String   @id @default(uuid())
  tenantId  String
  eventId   String
  eventType String
  createdAt DateTime @default(now())

  @@unique([tenantId, eventId])
  @@index([tenantId])
  @@map("processed_events")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id        String          @id @default(uuid())
  tenantId  String
  code      String
  name      String
  address   String?
  province  String?
  country   String?
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime        @default(now())

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  locations        Location[]
  purchaseOrders   PurchaseOrder[]
  customerOrders   CustomerOrder[]
  goodsReceipts    GoodsReceipt[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  outboundShipments Shipment[]     @relation("OutboundWarehouse")
  inboundShipments  Shipment[]     @relation("InboundWarehouse")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

// Bin/location granularity — modeled now, populated starting phase 1.5.
// StockLevel.locationId stays null until then; MVP tracks stock at the
// warehouse level only (see manifest §3).
model Location {
  id          String  @id @default(uuid())
  tenantId    String
  warehouseId String
  code        String

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  stockLevels StockLevel[]

  @@unique([warehouseId, code])
  @@index([tenantId])
  @@map("locations")
}

// Materialized cache of on-hand / reserved quantity per product+warehouse
// (+ optional location, phase 1.5+). Always written alongside the
// StockMovement row that caused the change — never written to on its own.
model StockLevel {
  id                String  @id @default(uuid())
  tenantId          String
  productId         String
  warehouseId       String
  locationId        String?
  quantityOnHand    Int     @default(0)
  quantityReserved  Int     @default(0)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@unique([productId, warehouseId, locationId])
  @@index([tenantId])
  @@map("stock_levels")
}

enum StockMovementType {
  RECEIPT
  FULFILLMENT
  ADJUSTMENT
  TRANSFER
}

// Append-only ledger. Source of truth for all inventory quantities.
model StockMovement {
  id                  String            @id @default(uuid())
  tenantId            String
  productId           String
  warehouseId         String
  type                StockMovementType
  quantityDelta       Int
  purchaseOrderLineId String?
  goodsReceiptLineId  String?
  customerOrderLineId String?
  note                String?
  createdByUserId     String?
  createdAt           DateTime          @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  goodsReceiptLine  GoodsReceiptLine?  @relation(fields: [goodsReceiptLineId], references: [id])
  customerOrderLine CustomerOrderLine? @relation(fields: [customerOrderLineId], references: [id])

  @@index([tenantId])
  @@index([productId, warehouseId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  customerOrders CustomerOrder[]

  @@index([tenantId])
  @@map("customers")
}

enum CustomerOrderStatus {
  DRAFT
  RESERVED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

model CustomerOrder {
  id          String              @id @default(uuid())
  tenantId    String
  customerId  String
  warehouseId String
  status      CustomerOrderStatus @default(DRAFT)
  createdAt   DateTime            @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  customer  Customer            @relation(fields: [customerId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     CustomerOrderLine[]
  shipment  Shipment?

  @@index([tenantId])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id              String @id @default(uuid())
  tenantId        String
  customerOrderId String
  productId       String
  qtyOrdered      Int
  qtyFulfilled    Int    @default(0)

  customerOrder  CustomerOrder   @relation(fields: [customerOrderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("customer_order_lines")
}

// ---------------------------------------------------------------------------
// Logistics
// ---------------------------------------------------------------------------

enum ShipmentDirection {
  INBOUND
  OUTBOUND
}

// Explicit lifecycle, phase 1: CREATED -> BOOKED -> IN_TRANSIT -> ARRIVED
// -> DELIVERED, with CANCELLED reachable up through IN_TRANSIT. Enforced
// in ShipmentsService, not by the enum — see
// docs/adr/0004-purchase-order-lifecycle.md.
enum ShipmentStatus {
  CREATED
  BOOKED
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

// One entity for both legs (see manifest §1): inbound ties to a
// PurchaseOrder + origin supplier, outbound ties to a CustomerOrder +
// destination customer. v1 tracking is manual (status set by hand);
// `carrier` / `trackingNumber` are captured for reference only until a
// carrier integration lands.
model Shipment {
  id                String            @id @default(uuid())
  tenantId          String
  shipmentNumber    String
  direction         ShipmentDirection
  status            ShipmentStatus    @default(CREATED)
  purchaseOrderId   String?           @unique
  customerOrderId   String?           @unique
  originWarehouseId String?
  destWarehouseId   String?
  carrier           String?
  trackingNumber    String?
  createdAt         DateTime          @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  customerOrder CustomerOrder? @relation(fields: [customerOrderId], references: [id])
  originWarehouse Warehouse?   @relation("InboundWarehouse", fields: [originWarehouseId], references: [id])
  destWarehouse   Warehouse?   @relation("OutboundWarehouse", fields: [destWarehouseId], references: [id])
  events        ShipmentEvent[]

  @@unique([tenantId, shipmentNumber])
  @@index([tenantId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  tenantId   String
  shipmentId String
  status     ShipmentStatus
  note       String?
  occurredAt DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([tenantId])
  @@index([shipmentId])
  @@map("shipment_events")
}
